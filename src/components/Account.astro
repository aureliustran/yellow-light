---
import { authProviders } from '../config';
---
<div class="account" data-account>
  <button type="button" class="btn small" data-login-open>Đăng nhập</button>
  <button type="button" class="icon-btn" data-account-toggle hidden aria-haspopup="true" aria-expanded="false" aria-label="Tài khoản">
    <span class="avatar" data-account-avatar></span>
  </button>
  <div class="account-menu" data-account-menu hidden>
    <span class="meta-small" style="padding: 8px 12px" data-account-name></span>
    <a href="/admin" data-account-admin hidden>Quản lý chương</a>
    <button type="button" data-logout>Đăng xuất</button>
  </div>
</div>

<dialog class="login" id="login-dialog" aria-labelledby="login-title">
  <button type="button" class="icon-btn close" data-login-close aria-label="Đóng">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <h2 id="login-title">Đăng nhập</h2>
  <p data-login-reason>Đọc truyện không cần tài khoản. Đăng nhập để bình luận và chấm điểm.</p>
  <div class="providers">
    {authProviders.map((p) => (
      <button type="button" class="btn primary big" data-provider={p.id}>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zM6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6L6.4 14zM12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z" /></svg>
        {p.label}
      </button>
    ))}
  </div>
</dialog>

<script>
  import { initAccount } from '../scripts/account';
  initAccount();
</script>
