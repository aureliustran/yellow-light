---
interface Props { label: string; small?: boolean; [attr: string]: unknown }
const { label, small = false, ...rest } = Astro.props;
---
<div class:list={['stars', { small }]} role="group" aria-label={label} {...rest}>
  {[1, 2, 3, 4, 5].map((n) => (
    <button type="button" class="star-btn" data-value={n} aria-pressed="false" aria-label={`${n} sao`}>
      <svg width={small ? 30 : 36} height={small ? 30 : 36} viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.5l2.9 6.2 6.8.8-5 4.7 1.3 6.7L12 17.6 6 20.9l1.3-6.7-5-4.7 6.8-.8L12 2.5z" />
      </svg>
    </button>
  ))}
</div>
