# Copy to .env for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API. These two are safe to expose to browsers.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for the import/export scripts on your computer and in GitHub Actions.
# NEVER add this to Vercel or commit it. It bypasses every security rule.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your public address (used in the sitemap and share previews).
SITE_URL=https://yellow-light.vercel.app

# Google OAuth2 client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application).
# The app code does NOT read these two variables. Google login runs through
# Supabase, so paste the same values into Supabase → Authentication →
# Providers → Google. They are kept here only as a local copy.
# Authorized redirect URI in Google: https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Redirect URL in Supabase (URL Configuration): https://YOUR-SITE/auth/callback
# NEVER add the secret to Vercel, GitHub Actions or the browser, and never commit it.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
