---
import Base from '../../layouts/Base.astro';
import Brand from '../../components/Brand.astro';
import Account from '../../components/Account.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import Stars from '../../components/Stars.astro';
import Footer from '../../components/Footer.astro';
import { isConfigured } from '../../lib/supabase';
import { getChapterPage } from '../../lib/chapters';
import { chapterLabel } from '../../lib/chapters-shared';
import { renderMarkdown, excerpt, stripTranslations } from '../../lib/markdown';

const { slug = '' } = Astro.params;
let page: Awaited<ReturnType<typeof getChapterPage>> = null;
let failed = false;
if (isConfigured) {
  try {
    page = await getChapterPage(slug);
  } catch (e) {
    failed = true;
    console.error(e);
  }
}

if (!page) {
  Astro.response.status = failed ? 503 : 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=300');
}

const c = page?.chapter;
const prev = page?.prev ?? null;
const next = page?.next ?? null;
const label = c ? chapterLabel(c) : '';
const html = c ? renderMarkdown(c.body) : '';
const words = c ? stripTranslations(c.body).split(/\s+/).filter(Boolean).length : 0;
const minutes = Math.max(1, Math.round(words / 230));
const hasTranslations = c ? /\[\[(en|ht):|^:::dich/m.test(c.body) : false;
---
{!c ? (
  <Base title={failed ? 'Lỗi tạm thời' : 'Không tìm thấy'} noindex bodyClass="fog">
    <header class="wrap site-header"><Brand /><nav class="nav"><ThemeToggle /></nav></header>
    <main class="narrow message-page">
      <h1>{failed ? 'Đèn đỏ' : 'Lạc đường rồi'}</h1>
      <p>{failed ? 'Không tải được chương này. Thử lại sau ít phút nhé.' : 'Chương này không tồn tại, hoặc chưa đến giờ lên đèn.'}</p>
      <a class="btn primary" href="/#muc-luc">Về mục lục</a>
    </main>
    <Footer />
  </Base>
) : (
  <Base title={`${label}: ${c.title}`} description={excerpt(c.body) || c.title}>
    <header class="site-header bar">
      <a href="/#muc-luc" class="btn ghost small" style="padding-left:8px">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        Mục lục
      </a>
      <Brand small />
      <div class="reader-tools">
        <button type="button" class="icon-btn" data-tr-all aria-pressed="false" hidden={!hasTranslations} title="Đổi tất cả cụm từ có bản dịch">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h8M8 3v2M6 5c0 4 3 7 6 8M10 5c0 3-3 7-6 8M13 21l4-9 4 9M14.5 18h5" /></svg>
          <span class="tool-label" style="margin-left:8px" data-tr-all-label>Bản dịch</span>
        </button>
        <button type="button" class="icon-btn" data-size-dec aria-label="Giảm cỡ chữ">A−</button>
        <button type="button" class="icon-btn" data-size-inc aria-label="Tăng cỡ chữ" style="font-size:18px">A+</button>
        <ThemeToggle showLabel />
        <Account />
      </div>
    </header>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>

    <main>
      <article class="chapter" data-chapter data-id={c.id} data-slug={c.slug} data-title={c.title} data-label={label}>
        <div class="eyebrow amber">{label}</div>
        <h1 class:list={{ italic: c.kind === 'interlude' }}>{c.title}</h1>
        <div class="chapter-meta">
          {c.story_date && <span class="story-date"><span class="lamp"></span>{c.story_date}</span>}
          <span class="meta-small">{minutes} phút đọc</span>
          <span class="meta-small" data-stat-views></span>
        </div>

        <span id="tr-hint" class="visually-hidden">Cụm từ có bản dịch. Bấm để đổi giữa nguyên bản và bản dịch.</span>
        <div class="prose" set:html={html} />

        <div class="chapter-end">
          <div class="scene-break" aria-hidden="true"><span></span><span class="lit"></span><span></span></div>
          <p>Hết {label === 'Interlude' ? c.title : label.toLowerCase()}</p>
        </div>

        <nav class="pager" aria-label="Chuyển chương">
          {prev ? (
            <a href={`/doc/${prev.slug}`} rel="prev">
              <div class="dir">← Trước</div>
              <div class="name">{prev.kind === 'chapter' ? (prev.number != null ? `Chương ${prev.number} · ` : 'Chương ') : ''}{prev.title}</div>
            </a>
          ) : (
            <div class="empty"><div class="dir">Trước</div><div class="name">Đây là phần đầu tiên</div></div>
          )}
          {next ? (
            <a class="next" href={`/doc/${next.slug}`} rel="next">
              <div class="dir">Tiếp →</div>
              <div class="name">{next.kind === 'chapter' ? (next.number != null ? `Chương ${next.number} · ` : 'Chương ') : ''}{next.title}</div>
            </a>
          ) : (
            <div class="empty"><div class="dir">Tiếp</div><div class="name">Chương sau đang được viết…</div></div>
          )}
        </nav>

        <section class="panel rate-panel" aria-labelledby="rate-title">
          <h2 id="rate-title">Chương này thế nào?</h2>
          <Stars label="Chấm điểm chương này" data-chapter-stars />
          <div class="hint" data-rating-hint>Chạm vào sao để chấm điểm.</div>
          <div class="summary" data-rating-summary></div>
        </section>

        <section class="comments" aria-labelledby="comments-title" data-comments>
          <div class="comments-head">
            <h2 id="comments-title">Bình luận</h2>
            <span class="meta-small" data-comment-count></span>
          </div>
          <form class="comment-form" data-comment-form>
            <label class="visually-hidden" for="comment-body">Viết bình luận</label>
            <textarea id="comment-body" rows="3" placeholder="Viết bình luận…" disabled></textarea>
            <div class="row" data-comment-loggedout>
              <span>Đăng nhập để bình luận. Đọc truyện thì không cần.</span>
              <button type="button" class="btn primary small" data-comment-login>Đăng nhập</button>
            </div>
            <div class="row" data-comment-loggedin hidden>
              <span data-comment-counter>0/2000</span>
              <button type="submit" class="btn primary small" data-comment-submit disabled>Gửi bình luận</button>
            </div>
          </form>
          <ul class="comment-list" data-comment-list></ul>
          <p class="empty-note" data-comment-empty hidden>Chưa có bình luận nào. Bạn là người đầu tiên?</p>
        </section>
      </article>
    </main>
    <Footer />
  </Base>
)}

<script>
  import { initReader } from '../../scripts/reader';
  initReader();
</script>
