---
import { story, editions } from '../config';
---
<footer class="site-footer">
  <div class="narrow">
    {story.footer.map((line) => <p>{line}</p>)}
    {story.crossposts.length > 0 && (
      <p class="also">
        Cũng đăng tại:{' '}
        {story.crossposts.map((c, i) => (
          <>{i > 0 && ', '}<a href={c.url} target="_blank" rel="noopener">{c.name}</a>{c.edition !== editions.current && ` (bản ${editions.names[c.edition]})`}</>
        ))}.
      </p>
    )}
  </div>
</footer>
