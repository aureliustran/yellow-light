---
import ChapterPage from '../../components/ChapterPage.astro';
import { isConfigured } from '../../lib/supabase';
import { chapterExists, getChapterPage } from '../../lib/chapters';
import { editions } from '../../config';

// /doc/ is the current edition. An address that only exists in Legacy (an old
// link, a share, a footer on another site) goes on to /legacy/.
const { slug = '' } = Astro.params;
let page: Awaited<ReturnType<typeof getChapterPage>> = null;
let failed = false;
let legacy = false;
if (isConfigured) {
  try {
    page = await getChapterPage(slug);
    if (!page && editions.current !== editions.legacy.id) legacy = await chapterExists(slug, editions.legacy.id);
  } catch (e) {
    failed = true;
    console.error(e);
  }
}
if (legacy) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');
  return Astro.redirect(`${editions.legacy.path}/${encodeURIComponent(slug)}`, 301);
}

if (!page) {
  Astro.response.status = failed ? 503 : 404;
  Astro.response.headers.set('Cache-Control', 'no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=300');
}
---
<ChapterPage page={page} failed={failed} base="/doc" />
